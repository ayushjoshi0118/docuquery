# ==============================================================================
# DocuQuery Platform Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME=DocuQuery
VERSION=1.0.0

# Security and Authentication
# Generate a strong key in production (e.g. openssl rand -hex 32)
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL with pgvector)
POSTGRES_USER=docuquery
POSTGRES_PASSWORD=docuquery_secret
POSTGRES_DB=docuquery
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://docuquery:docuquery_secret@localhost:5432/docuquery

# Background Jobs (Redis & Celery)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Object Storage (MinIO / S3)
STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=./data/storage
S3_PORT=9000
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=docuquery-documents
S3_REGION_NAME=us-east-1

# Document Limits
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
MAX_DOCUMENT_PAGES=500
USER_STORAGE_LIMIT_BYTES=104857600 # 100 MB

# RAG & Embeddings Configuration
# Options: "mock" (offline test), "gemini", "openai", "ollama"
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# LLM Generation Configuration
# Options: "mock", "gemini", "openai", "ollama"
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

# API Keys (leave empty or fill when using cloud providers)
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Retrieval Hyperparameters
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25
CHUNK_SIZE=800
CHUNK_OVERLAP=150
